# LLM (Groq — OpenAI-compatible API, free tier)
OPENAI_API_KEY=gsk_your_groq_api_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Embeddings (local sentence-transformers — no API key needed)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384

# Qdrant Cloud
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=textbook_chunks

# Neon Postgres
DATABASE_URL=postgresql+asyncpg://user:password@ep-your-project.us-east-2.aws.neon.tech/neondb?ssl=require

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://faizanmasood302.github.io

# Content
CONTENT_DIR=../website/docs
